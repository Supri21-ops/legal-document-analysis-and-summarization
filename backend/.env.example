# ===================================================================
# LegalAI Backend Environment Configuration
# ===================================================================

# Database configuration (Defaults to SQLite in backend root)
DATABASE_URL=sqlite:///./legal_db.db

# Generative AI Keys
# Provide your Google Gemini API key to enable Gemini 2.0 Flash features
GEMINI_API_KEY=
# Optional fallback to Anthropic Claude
ANTHROPIC_API_KEY=

# Security & Authentication
# Replace with a strong cryptographically generated secret in production
SECRET_KEY=legal_ai_secret_key_2026_jwt_token_auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Blockchain Verification (Ganache Ethereum RPC)
GANACHE_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]
